{
  "name": "paddock",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance personal productivity system with Kanban boards and time tracking",
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "dev:web": "pnpm --filter web dev",
